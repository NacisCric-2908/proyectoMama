# PostgreSQL (local con docker compose, o Neon en producción)
DATABASE_URL="postgresql://costeo:costeo@localhost:5433/costeo"
# En Neon usar la URL sin pooler para migraciones; en local puede ser la misma
DIRECT_URL="postgresql://costeo:costeo@localhost:5433/costeo"
# Secreto de sesiones: genere uno con `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET="cambie-este-secreto"
AUTH_TRUST_HOST=true
