// Sistema de costeo por órdenes de proyecto — modelo de datos (Fase 1)
// Dinero y cantidades: Decimal de precisión fija. Nunca Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── Seguridad ─────────────

model Rol {
  id       String    @id @default(cuid())
  clave    String    @unique // ADMINISTRADOR, CONTADOR, COORDINADOR, TECNICO, GERENCIA
  nombre   String
  permisos Permiso[]
  usuarios Usuario[]
}

model Permiso {
  id    String @id @default(cuid())
  rolId String
  clave String
  rol   Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([rolId, clave])
}

model Usuario {
  id             String      @id @default(cuid())
  email          String      @unique
  nombre         String
  hashContrasena String
  rolId          String
  rol            Rol         @relation(fields: [rolId], references: [id])
  trabajadorId   String?     @unique
  trabajador     Trabajador? @relation(fields: [trabajadorId], references: [id])
  activo         Boolean     @default(true)
  creadoEn       DateTime    @default(now())
  modificadoEn   DateTime    @updatedAt

  ordenesResponsable OrdenProyecto[] @relation("Responsable")
}

model ParametrosGenerales {
  id                  Int      @id @default(1)
  nombreEmpresa       String
  logo                String? // data URL (base64)
  margenMinimoGlobal  Decimal  @default(15) @db.Decimal(9, 4)
  formatoCodigoOrden  String   @default("OP-{AAAA}-{NNNN}")
  baseCifDefecto      BaseCIF  @default(HORAS_MOD)
  umbralMermaPct      Decimal  @default(10) @db.Decimal(9, 4)
  /// Política: la merma anormal se reconoce como pérdida del período y no como costo de la orden.
  excluirMermaAnormal Boolean  @default(false)
  moneda              String   @default("COP")
  modificadoEn        DateTime @updatedAt
}

// ───────────── Catálogos ─────────────

model Cliente {
  id           String          @id @default(cuid())
  nombre       String
  nit          String?
  contacto     String?
  telefono     String?
  correo       String?
  ciudad       String?
  activo       Boolean         @default(true)
  creadoEn     DateTime        @default(now())
  modificadoEn DateTime        @updatedAt
  eliminadoEn  DateTime?
  ordenes      OrdenProyecto[]
}

model Material {
  id              String                 @id @default(cuid())
  codigo          String                 @unique
  descripcion     String
  unidad          String
  categoria       String
  costoReferencia Decimal                @db.Decimal(18, 4)
  activo          Boolean                @default(true)
  creadoEn        DateTime               @default(now())
  modificadoEn    DateTime               @updatedAt
  eliminadoEn     DateTime?
  consumos        ConsumoMaterial[]
  movimientos     MovimientoInventario[]
}

enum TipoTrabajador {
  FABRICACION
  INGENIERIA
  AMBOS
}

model Trabajador {
  id           String               @id @default(cuid())
  nombre       String
  documento    String?
  cargo        String
  tipo         TipoTrabajador
  activo       Boolean              @default(true)
  creadoEn     DateTime             @default(now())
  modificadoEn DateTime             @updatedAt
  eliminadoEn  DateTime?
  tarifas      TarifaTrabajador[]
  usuario      Usuario?
  registrosMOD RegistroMOD[]
  registrosIng RegistroIngenieria[]
}

model TarifaTrabajador {
  id           String     @id @default(cuid())
  trabajadorId String
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])
  costoHora    Decimal    @db.Decimal(18, 4)
  vigenteDesde DateTime   @db.Date
  vigenteHasta DateTime?  @db.Date
  creadoEn     DateTime   @default(now())

  @@index([trabajadorId, vigenteDesde])
}

enum GrupoEtapa {
  INGENIERIA_AUTOMATIZACION
  PRUEBAS_PUESTA_MARCHA
}

model Etapa {
  id        String                   @id @default(cuid())
  nombre    String                   @unique
  grupo     GrupoEtapa
  orden     Int
  activa    Boolean                  @default(true)
  registros RegistroIngenieria[]
  servicios ServicioAdicionalEtapa[]
  consumos  ConsumoMaterial[]
}

// ───────────── Órdenes ─────────────

enum EstadoOrden {
  BORRADOR
  COTIZADO
  EN_INGENIERIA
  EN_FABRICACION
  EN_PRUEBAS
  EN_PUESTA_MARCHA
  TERMINADO
  FACTURADO
  ANULADO
}

model OrdenProyecto {
  id                   String      @id @default(cuid())
  codigo               String      @unique
  clienteId            String?
  cliente              Cliente?    @relation(fields: [clienteId], references: [id])
  descripcion          String      @default("")
  cantidadUnidades     Decimal     @default(1) @db.Decimal(18, 4)
  fechaCreacion        DateTime    @db.Date
  fechaEstimadaEntrega DateTime?   @db.Date
  fechaTerminacion     DateTime?   @db.Date
  estado               EstadoOrden @default(BORRADOR)
  responsableId        String?
  responsable          Usuario?    @relation("Responsable", fields: [responsableId], references: [id])
  valorCotizado        Decimal?    @db.Decimal(18, 2)
  margenEsperadoPct    Decimal?    @db.Decimal(9, 4)
  margenMinimoPct      Decimal?    @db.Decimal(9, 4)
  numeroFactura        String?
  fechaFactura         DateTime?   @db.Date
  observaciones        String?
  /// Resumen de costos estimado al pasar a Cotizado (JSON serializado del motor).
  estimadoAlCotizar    Json?
  /// Resumen de costos congelado al cierre.
  snapshotCierre       Json?
  cerradoPorId         String?
  cerradoEn            DateTime?
  creadoPorId          String?
  creadoEn             DateTime    @default(now())
  modificadoPorId      String?
  modificadoEn         DateTime    @updatedAt
  eliminadoEn          DateTime?

  materiales    ConsumoMaterial[]
  registrosMOD  RegistroMOD[]
  registrosIng  RegistroIngenieria[]
  servicios     ServicioAdicionalEtapa[]
  asignacionCIF AsignacionCIF?
  historial     HistorialEstado[]
  tecnicos      AsignacionTecnico[]
  presupuestos  PresupuestoOrden[]
  ajustesCIF    AjusteCIFOrden[]
  explicaciones ExplicacionDesviacion[]
  movimientos   MovimientoInventario[]

  @@index([estado])
  @@index([clienteId])
}

/// Técnicos / ingenieros asignados a una orden (pueden registrar horas en ella).
model AsignacionTecnico {
  ordenId      String
  trabajadorId String
  orden        OrdenProyecto @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@id([ordenId, trabajadorId])
}

model ConsumoMaterial {
  id                    String                 @id @default(cuid())
  ordenId               String
  orden                 OrdenProyecto          @relation(fields: [ordenId], references: [id])
  materialId            String
  material              Material               @relation(fields: [materialId], references: [id])
  etapaId               String?
  etapa                 Etapa?                 @relation(fields: [etapaId], references: [id])
  cantidadRequerida     Decimal                @default(0) @db.Decimal(18, 4)
  cantidadEntregada     Decimal?               @db.Decimal(18, 4)
  cantidadUtilizada     Decimal                @default(0) @db.Decimal(18, 4)
  cantidadDevuelta      Decimal                @default(0) @db.Decimal(18, 4)
  causaMerma            String?
  clasificacionMerma    ClasificacionMerma?
  /// Destino autorizado de la merma: descarte, reparación, reutilización, venta como chatarra…
  disposicionMerma      String?
  valorRecuperado       Decimal                @default(0) @db.Decimal(18, 2)
  costoUnitarioAplicado Decimal                @db.Decimal(18, 4)
  creadoEn              DateTime               @default(now())
  modificadoEn          DateTime               @updatedAt
  eliminadoEn           DateTime?
  movimientos           MovimientoInventario[]

  @@index([ordenId])
}

enum ClasificacionMerma {
  NORMAL
  ANORMAL
  RECUPERABLE
}

model RegistroMOD {
  id             String        @id @default(cuid())
  ordenId        String
  orden          OrdenProyecto @relation(fields: [ordenId], references: [id])
  trabajadorId   String?
  trabajador     Trabajador?   @relation(fields: [trabajadorId], references: [id])
  cargo          String?
  actividad      String
  fecha          DateTime      @db.Date
  horas          Decimal       @db.Decimal(18, 4)
  tarifaAplicada Decimal       @db.Decimal(18, 4)
  creadoPorId    String?
  creadoEn       DateTime      @default(now())
  modificadoEn   DateTime      @updatedAt
  eliminadoEn    DateTime?

  @@index([ordenId])
}

model RegistroIngenieria {
  id                    String        @id @default(cuid())
  ordenId               String
  orden                 OrdenProyecto @relation(fields: [ordenId], references: [id])
  etapaId               String
  etapa                 Etapa         @relation(fields: [etapaId], references: [id])
  responsableId         String
  responsable           Trabajador    @relation(fields: [responsableId], references: [id])
  fechaInicio           DateTime      @db.Date
  fechaFin              DateTime      @db.Date
  horas                 Decimal       @db.Decimal(18, 4)
  costoHoraAplicado     Decimal       @db.Decimal(18, 4)
  descripcion           String
  observacionesTecnicas String?
  creadoPorId           String?
  creadoEn              DateTime      @default(now())
  modificadoEn          DateTime      @updatedAt
  eliminadoEn           DateTime?

  @@index([ordenId])
}

model ServicioAdicionalEtapa {
  id           String        @id @default(cuid())
  ordenId      String
  orden        OrdenProyecto @relation(fields: [ordenId], references: [id])
  etapaId      String
  etapa        Etapa         @relation(fields: [etapaId], references: [id])
  descripcion  String
  valor        Decimal       @db.Decimal(18, 2)
  creadoEn     DateTime      @default(now())
  modificadoEn DateTime      @updatedAt
  eliminadoEn  DateTime?

  @@index([ordenId])
}

/// Presupuesto de costo por componente, versionado. La versión 1 es el presupuesto original;
/// las siguientes registran cambios de especificación (con motivo). Solo las aprobadas se comparan.
model PresupuestoOrden {
  id                       String                  @id @default(cuid())
  ordenId                  String
  orden                    OrdenProyecto           @relation(fields: [ordenId], references: [id])
  version                  Int
  materialesDirectos       Decimal                 @db.Decimal(18, 2)
  manoObraDirecta          Decimal                 @db.Decimal(18, 2)
  ingenieriaAutomatizacion Decimal                 @db.Decimal(18, 2)
  pruebasPuestaMarcha      Decimal                 @db.Decimal(18, 2)
  cif                      Decimal                 @db.Decimal(18, 2)
  mermas                   Decimal                 @default(0) @db.Decimal(18, 2)
  horasEnsamble            Decimal                 @default(0) @db.Decimal(18, 4)
  horasIngenieria          Decimal                 @default(0) @db.Decimal(18, 4)
  motivo                   String?
  creadoPorId              String?
  creadoPorNombre          String?
  creadoEn                 DateTime                @default(now())
  aprobadoPorId            String?
  aprobadoPorNombre        String?
  aprobadoEn               DateTime?
  explicaciones            ExplicacionDesviacion[]

  @@unique([ordenId, version])
}

enum CausaDesviacion {
  PRECIO_MATERIALES
  CANTIDAD_MATERIALES
  HORAS
  TARIFAS
  CAMBIO_CLIENTE
  METODO_ESTIMACION
  CIF
  OTRA
}

/// Explicación documentada de la diferencia de un componente frente a una versión del presupuesto (D11).
/// La causa es declarada: no se trata como causalidad demostrada.
model ExplicacionDesviacion {
  id            String           @id @default(cuid())
  ordenId       String
  orden         OrdenProyecto    @relation(fields: [ordenId], references: [id])
  presupuestoId String
  presupuesto   PresupuestoOrden @relation(fields: [presupuestoId], references: [id])
  componente    String
  /// Diferencia (real − presupuesto) al momento de explicarla.
  diferencia    Decimal          @db.Decimal(18, 2)
  causa         CausaDesviacion
  explicacion   String
  soporte       String?
  usuarioId     String?
  usuarioNombre String?
  fecha         DateTime         @default(now())

  @@unique([presupuestoId, componente])
}

// ───────────── Inventario (kárdex) ─────────────

enum TipoMovimiento {
  ENTRADA
  SALIDA_ORDEN
  DEVOLUCION_ORDEN
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

/// Kárdex perpetuo valorado por promedio ponderado. Los movimientos no se editan ni se borran:
/// se corrigen con devoluciones o ajustes. Cada fila guarda el saldo resultante.
model MovimientoInventario {
  id                  String           @id @default(cuid())
  secuencia           Int              @default(autoincrement())
  materialId          String
  material            Material         @relation(fields: [materialId], references: [id])
  fecha               DateTime         @db.Date
  tipo                TipoMovimiento
  cantidad            Decimal          @db.Decimal(18, 4)
  costoUnitario       Decimal          @db.Decimal(18, 4)
  costoTotal          Decimal          @db.Decimal(18, 4)
  saldoCantidad       Decimal          @db.Decimal(18, 4)
  saldoValor          Decimal          @db.Decimal(18, 4)
  costoPromedio       Decimal          @db.Decimal(18, 4)
  ordenId             String?
  orden               OrdenProyecto?   @relation(fields: [ordenId], references: [id])
  consumoId           String?
  consumo             ConsumoMaterial? @relation(fields: [consumoId], references: [id])
  /// Factura, orden de compra, número de requisición o acta.
  documento           String?
  /// Proveedor en las entradas.
  tercero             String?
  /// Quien solicita el material (requisición) o lo devuelve.
  solicitante         String?
  autorizadoPorId     String?
  autorizadoPorNombre String?
  observaciones       String?
  creadoEn            DateTime         @default(now())

  @@index([materialId, secuencia])
  @@index([ordenId])
}

// ───────────── CIF ─────────────

enum BaseCIF {
  HORAS_MOD
  HORAS_TOTALES
  COSTO_MOD
  COSTO_DIRECTO
  NUMERO_PROYECTOS
  ACTIVIDADES
}

enum ActividadCIF {
  ENSAMBLE
  INGENIERIA
  PRUEBAS_PUESTA_MARCHA
  MATERIALES
}

/// Tasa predeterminada de una actividad (base «Tasas diferenciadas por actividad»).
model TasaActividadCIF {
  id               String       @id @default(cuid())
  parametroId      String
  parametro        ParametroCIF @relation(fields: [parametroId], references: [id], onDelete: Cascade)
  actividad        ActividadCIF
  tasaDirecta      Decimal?     @db.Decimal(18, 6)
  cifPresupuestado Decimal?     @db.Decimal(18, 2)
  baseEstimada     Decimal?     @db.Decimal(18, 4)

  @@unique([parametroId, actividad])
}

model ParametroCIF {
  id               String             @id @default(cuid())
  periodo          String             @unique // aaaa-mm
  base             BaseCIF
  /// Tasa ingresada directamente ($/hora, % o $/proyecto según la base).
  tasaDirecta      Decimal?           @db.Decimal(18, 6)
  cifPresupuestado Decimal?           @db.Decimal(18, 2)
  baseEstimada     Decimal?           @db.Decimal(18, 4)
  observaciones    String?
  modificadoEn     DateTime           @updatedAt
  creadoEn         DateTime           @default(now())
  tasasActividad   TasaActividadCIF[]
}

model AsignacionCIF {
  id                      String        @id @default(cuid())
  ordenId                 String        @unique
  orden                   OrdenProyecto @relation(fields: [ordenId], references: [id])
  periodo                 String
  base                    BaseCIF
  tasaAplicada            Decimal       @db.Decimal(18, 6)
  /// Cantidad de la base y valor al momento de la última asignación (informativos; el motor recalcula mientras esté abierta).
  cantidadBase            Decimal       @db.Decimal(18, 4)
  valorAsignado           Decimal       @db.Decimal(18, 2)
  justificacionCambioBase String?
  /// Tasas por actividad aplicadas (base ACTIVIDADES): [{ actividad, tasa }].
  tasasActividad          Json?
  usuarioId               String?
  fecha                   DateTime      @default(now())
}

/// CIF real del período por concepto (arriendo, energía, depreciación, supervisión…).
model ConceptoCIFReal {
  id            String    @id @default(cuid())
  periodo       String
  concepto      String
  valor         Decimal   @db.Decimal(18, 2)
  soporte       String?
  observaciones String?
  creadoPorId   String?
  creadoEn      DateTime  @default(now())
  eliminadoEn   DateTime?

  @@index([periodo])
}

enum PoliticaAjusteCIF {
  PRORRATEO_CIF_APLICADO
  COSTO_DE_VENTAS
}

/// Conciliación del CIF real con el CIF aplicado de un período. Solo una vigente (no anulada) por período.
model ConciliacionCIF {
  id                String            @id @default(cuid())
  periodo           String
  cifReal           Decimal           @db.Decimal(18, 2)
  cifAplicado       Decimal           @db.Decimal(18, 2)
  diferencia        Decimal           @db.Decimal(18, 2)
  ajusteCostoVentas Decimal           @default(0) @db.Decimal(18, 2)
  politica          PoliticaAjusteCIF
  observaciones     String?
  usuarioId         String?
  usuarioNombre     String?
  fecha             DateTime          @default(now())
  anuladaEn         DateTime?
  anuladaPor        String?
  motivoAnulacion   String?
  ajustes           AjusteCIFOrden[]

  @@index([periodo])
}

/// Costo ajustado de cada orden tras la conciliación del CIF.
model AjusteCIFOrden {
  id             String          @id @default(cuid())
  conciliacionId String
  conciliacion   ConciliacionCIF @relation(fields: [conciliacionId], references: [id])
  ordenId        String
  orden          OrdenProyecto   @relation(fields: [ordenId], references: [id])
  cifAplicado    Decimal         @db.Decimal(18, 2)
  ajuste         Decimal         @db.Decimal(18, 2)
  costoAcumulado Decimal         @db.Decimal(18, 2)
  costoAjustado  Decimal         @db.Decimal(18, 2)

  @@unique([conciliacionId, ordenId])
  @@index([ordenId])
}

// ───────────── Trazabilidad ─────────────

model HistorialEstado {
  id             String        @id @default(cuid())
  ordenId        String
  orden          OrdenProyecto @relation(fields: [ordenId], references: [id])
  estadoAnterior EstadoOrden?
  estadoNuevo    EstadoOrden
  comentario     String?
  usuarioId      String?
  usuarioNombre  String?
  fecha          DateTime      @default(now())

  @@index([ordenId])
}

model Auditoria {
  id            String   @id @default(cuid())
  entidad       String
  entidadId     String
  campo         String
  valorAnterior String?
  valorNuevo    String?
  usuarioId     String?
  usuarioNombre String?
  fecha         DateTime @default(now())

  @@index([entidad, entidadId])
}
